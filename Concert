package mz.proizvod;


public class Main {

    public static void main(String[] args) {

        Proizvod p1 = new Proizvod("Čaj od kamilice", 3.50, 15);
        Proizvod p2 = new Proizvod("Mokoš kava", 6.80, 20);
        Proizvod p3 = new Proizvod("Mineralna voda", 1.20); // Koristi drugi konstruktor (količina 0)


        System.out.println(p1.opis());
        System.out.println(p2.opis());
        System.out.println(p3.opis());


        p1.dodaj(10);
        p2.prodaj(5);
        p3.dodaj(50);
        
        System.out.println("\nNakon promjena stanja:");
        System.out.println(p1.opis());
        System.out.println(p2.opis());


        try {
            p2.prodaj(1000); // Previše prodaje (palo bi ispod nule)
        } catch (IllegalArgumentException e) {
            System.out.println("Odbijeno: " + e.getMessage());
        }

        try {
            new Proizvod("    ", 5.00); // Prazan naziv
        } catch (IllegalArgumentException e) {
            System.out.println("Odbijeno: " + e.getMessage());
        }

        try {
            p1.setCijena(-2.50); // Negativna cijena
        } catch (IllegalArgumentException e) {
            System.out.println("Odbijeno: " + e.getMessage());
        }


        System.out.printf("\nUkupna vrijednost proizvoda 1: %.2f EUR%n", p1.ukupnaVrijednost());
        System.out.printf("Ukupna vrijednost proizvoda 1 uz 10%% popusta: %.2f EUR%n", p1.ukupnaVrijednost(10));
        System.out.println("Ukupan broj stvorenih proizvoda: " + Proizvod.getProizvodCount());
    }
}
